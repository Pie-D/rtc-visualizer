APP_NAME=rtc-visualizer
APP_PORT=8087

# Set the service type. Can be "AWS" or "MongoDB".
RTCSTATS_SERVICE_TYPE=MongoDB

AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy
RTCSTATS_S3_BUCKET=jitsi-micros-rtcstats-server
RTCSTATS_S3_ENDPOINT=
RTCSTATS_METADATA_TABLE=rtcstats-meta-table-local
RTCSTATS_DYNAMODB_ENDPOINT=
RTCSTATS_JWT_PUBLIC_KEY=
RTCSTATS_JWT_EGHT_PUBLIC_KEY=
RTCSTATS_FILES_ENDPOINT=
USERS_FILE=.data/users.json

RTCSTATS_MONGODB_URI=mongodb://root:root@10.1.6.35:27017
RTCSTATS_MONGODB_NAME=rtcstats-db
RTCSTATS_METADATA_COLLECTION=rtcstats-meta-collection
RTCSTATS_GRIDFS_BUCKET=rtcstats-dump-file-bucket

# Keycloak SSO Authentication Configuration
KEYCLOAK_ENABLED=true
KEYCLOAK_AUTH_SERVER_URL=https://iam.cmcati.vn
KEYCLOAK_REALM=cmeet-dev
KEYCLOAK_CLIENT_ID=c-meet-online
# KEYCLOAK_CLIENT_SECRET=<your-client-secret> # (Chỉ cần nếu Client Access Type là "confidential")

# Khóa công khai của Realm để verify token (lấy từ Keycloak Admin Console -> Realm Settings -> Keys)
# Có thể để dạng chuỗi ký tự liền nhau, hệ thống sẽ tự động thêm header PEM công khai.

# URL Callback sau khi đăng nhập thành công (Tùy chọn, mặc định sẽ tự động lấy theo Host)
KEYCLOAK_REDIRECT_URI=http://10.2.6.25:8087/keycloak/callback

